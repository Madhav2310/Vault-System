# Copy to .env and fill in. Every Settings field (backend/app/core/settings.py) is listed here.

# environment
ENVIRONMENT=dev
SERVICE_VERSION=dev

# infrastructure (required)
DATABASE_URL=postgresql+asyncpg://vault:vault@postgres:5432/vault
REDIS_URL=redis://redis:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# object store
OBJECT_STORE_BACKEND=local
OBJECT_STORE_ROOT=/data/blobs

# reranker
RERANKER_URL=http://reranker:8080
RERANKER_TIMEOUT_MS=800

# providers (secrets; never commit real values)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# llm provider: openai | fake (fake = scripted UI-test model; refused when ENVIRONMENT=prod)
LLM_PROVIDER=openai

# models
MODEL_FAST=gpt-6-luna
MODEL_BALANCED=gpt-6.1-terra
MODEL_DEEP=gpt-6.1-sol
MODEL_FLAGSHIP=gpt-6-astra
# JSON per-node overrides over the routing table: {"analyze_query": {"role": "balanced", "effort": "low"}}
MODEL_ROUTES={}
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM gateway
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_S=0.5
LLM_RETRY_MAX_S=8
# JSON, USD per MTok, merged over built-in prices: {"gpt-6.1-terra": {"input": 1, "output": 5}}
LLM_PRICES={}

# limits
MAX_UPLOAD_BYTES=26214400
PARSE_TIMEOUT_S=120
EMBED_CONCURRENCY=4
CHUNKER_VERSION=chunker@1
BRIEF_CONCURRENCY=3
MAX_PAGES=600
PARSE_MEMORY_MB=2048

# per-user rate limits (requests per window; design 13.4)
RATE_LIMIT_CHAT_POST_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_DEFAULT_PER_MIN=300
RATE_LIMIT_WINDOW_S=60
USER_DAILY_USD=1.00

# document brief (design 9.1)
BRIEF_MAX_EVIDENCE_TOKENS=12000
BRIEF_MAX_USD=0.05

# contextual chunk headers, index side only (design 6.5); off | deterministic | llm, off until the A/B decides
CONTEXTUALIZE_VARIANT=off
CONTEXTUALIZE_MAX_USD=0.02

# retrieval config file under backend/config
RETRIEVAL_CONFIG=retrieval@2

# whole-document answering (design 8.2); auto stays off until the answer A/B decides
FULL_CONTEXT_AUTO=false
FULL_CONTEXT_MAX_DOCS=3
FULL_CONTEXT_MAX_TOKENS=50000

# fast path (design 8.2): skip the analyze call for simple first-turn questions; false = always analyze
CHAT_FAST_PATH=true
# latency overlap: retrieve (incl. cross-encoder rerank) on the raw question while analyze runs
CHAT_SPECULATIVE_RETRIEVAL=true

# S22.04 plan-first answers (answer_rag@4 + coverage plan); off until the paired A/B accepts it
CHAT_PLAN_FIRST=false

# telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
OTEL_SERVICE_NAME=vault-api
LOG_LEVEL=INFO

# UI session cookie (S22.11); SESSION_SECRET is optional extra HMAC key material
SESSION_TTL_S=28800
SESSION_SECRET=

# compose-only
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=vault
