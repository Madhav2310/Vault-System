# Copy to .env and fill in. Every Settings field (backend/app/core/settings.py) is listed here.

# environment
ENVIRONMENT=dev
SERVICE_VERSION=dev

# infrastructure (required)
DATABASE_URL=postgresql+asyncpg://vault:vault@postgres:5432/vault
REDIS_URL=redis://redis:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# object store
OBJECT_STORE_BACKEND=local
OBJECT_STORE_ROOT=/data/blobs

# reranker
RERANKER_URL=http://reranker:8080
RERANKER_TIMEOUT_MS=800

# providers (secrets; never commit real values)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# models
MODEL_FAST=gpt-6-luna
MODEL_BALANCED=gpt-6.1-terra
MODEL_DEEP=gpt-6.1-sol
MODEL_FLAGSHIP=gpt-6-astra
# JSON per-node overrides over the routing table: {"analyze_query": {"role": "balanced", "effort": "low"}}
MODEL_ROUTES={}
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM gateway
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_S=0.5
LLM_RETRY_MAX_S=8
# JSON, USD per MTok, merged over built-in prices: {"gpt-6.1-terra": {"input": 1, "output": 5}}
LLM_PRICES={}

# limits
MAX_UPLOAD_BYTES=26214400
PARSE_TIMEOUT_S=120

# telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4317
OTEL_SERVICE_NAME=vault-api
LOG_LEVEL=INFO

# compose-only
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault
POSTGRES_DB=vault
