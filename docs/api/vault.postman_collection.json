            "description": "A cited summary of the document's current version (`length`, optional `focus` and `tone`). 200 with\nthe summary when the same parameters were already produced, else 202 with a poll URL.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"length\": \"short\",\n  \"focus\": \"string\",\n  \"tone\": \"neutral\"\n}",
              "options": {
                "raw": {
