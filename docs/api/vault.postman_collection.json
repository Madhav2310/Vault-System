              "raw": "{{baseUrl}}/v1/documents/:document_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "documents",
                ":document_id"
              ],
              "variable": [
                {
                  "key": "document_id",
                  "value": "00000000-0000-0000-0000-000000000000"
                }
              ]
            },
            "description": "Soft delete: hidden from every read immediately; chunks, insights, layouts and the blob go in an\nasync purge."
          },
          "response": []
        },
        {
          "name": "Get the document brief (GET /v1/documents/{document_id}/brief)",
          "request": {
            "method": "GET",
            "header": [],
