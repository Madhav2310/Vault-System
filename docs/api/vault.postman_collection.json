              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "documents"
              ]
            },
            "description": "Upload a PDF, DOCX, TXT or MD file (\u2264 25 MB). Returns 202 and starts processing; re-uploading the same\nbytes returns the existing version with `deduplicated: true` (200).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
