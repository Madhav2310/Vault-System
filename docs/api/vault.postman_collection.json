            "description": "Upload a new version (`version_no = max + 1`) of one of your documents and start processing it. When\nit becomes ready it replaces the current version (the old one becomes `superseded`) and new chat scopes\nuse it. Identical bytes to the newest version return that version with `deduplicated: true` (200).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Processing status of a version (GET /v1/versions/{version_id}/processing)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/versions/:version_id/processing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "versions",
                ":version_id",
                "processing"
