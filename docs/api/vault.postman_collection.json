          "response": []
        },
        {
          "name": "Stream processing status (GET /v1/versions/{version_id}/processing/stream)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/versions/:version_id/processing/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "versions",
                ":version_id",
                "processing",
                "stream"
              ],
              "variable": [
                {
                  "key": "version_id",
                  "value": "00000000-0000-0000-0000-000000000000"
                }
              ]
            },
            "description": "Server-sent events: one `stage{name, status, attempt, at, error_code?}` per `job_events` row (the past\nfirst, then live as stages commit), then a terminal `done{status, error_code}`. `: heartbeat` comments\nevery 15 s; closes at a terminal status or after 10 minutes (`timeout`: reconnect to resume)."
          },
          "response": []
        },
        {
          "name": "Inspect a source chunk (GET /v1/chunks/{chunk_id})",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/chunks/:chunk_id",
