              "query": [
                {
                  "key": "include_unverified",
                  "value": "",
                  "disabled": true
                }
              ],
              "variable": [
                {
                  "key": "document_id",
                  "value": "00000000-0000-0000-0000-000000000000"
                }
              ]
            },
            "description": "The cited brief of the document's current version. `status: pending` (200) until it exists;\n`include_unverified=false` drops facts the application could not verify against their citations."
          },
          "response": []
        },
        {
          "name": "Request a cited summary (POST /v1/documents/{document_id}/summaries)",
          "request": {
            "method": "POST",
            "header": [
